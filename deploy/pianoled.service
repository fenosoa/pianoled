# systemd unit for the Raspberry Pi. Adjust User and WorkingDirectory, then:
#   sudo cp deploy/pianoled.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pianoled
[Unit]
Description=PianoLED MIDI -> DDP engine with RTP-MIDI routing
After=network-online.target sound.target rtpmidid.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=pi
Group=audio
WorkingDirectory=/home/pi/ownpianoled
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/cli/run.js
# SIGTERM -> black frames + socket close (see src/cli/run.js).
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=on-failure
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
