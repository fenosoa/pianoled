# Copy to .env and adjust. Real environment variables override this file. No secrets here.
# Values below are the built-in defaults unless marked "example".

# ---- DDP / WLED (GLEDOPTO ESP32, WLED 0.15.1) ----
WLED_HOST=192.168.1.41
DDP_PORT=4048
# LED_COUNT is fixed to 120 in code (indices 0..119); any other value is rejected.
# Keepalive frame rate (Hz) while running.
FPS=40
# always: resend current frame at FPS (keeps WLED in realtime mode) | active: only while LEDs lit or recent change | off
KEEPALIVE=always
IDLE_KEEPALIVE_MS=3000
# 0 = flush on next event-loop turn (groups events received together); >0 = wait this many ms.
COALESCE_MS=0
# Minimum gap between two change frames (caps burst rate at 1000/MIN_FRAME_GAP_MS fps).
MIN_FRAME_GAP_MS=5
BLACK_FRAMES_ON_STOP=3
# 1 = no network packet, only logs and counters.
DRY_RUN=0

# ---- Colors ----
# Global scale 0..1 applied to every color (power budget; 80 white LEDs at 1.0 draw a lot).
BRIGHTNESS=0.25
# Keyboard (you) / Synthesia / same note lit by both.
COLOR_KEYBOARD=#FF4D9D
COLOR_SYNTHESIA=#007BFF
COLOR_OVERLAP=#00FF00
OVERLAP_BOOST=2
COLOR_SYNTHESIA_BLACK=#A855F7
COLOR_GREEN=0,255,0
COLOR_BLUE=0,0,255
# Synthesia color rule. Channels are written 1..16 here (code uses 0..15).
# Default: every Synthesia channel uses COLOR_SYNTHESIA. Set the per-channel rule ONLY after `npm run capture`.
SYNTH_DEFAULT_COLOR=synthesia
# example: SYNTH_CHANNEL_COLORS=1:green,2:blue
SYNTH_CHANNEL_COLORS=
# brightness multiplier per Synthesia channel (channel:factor), default 2:3
SYNTH_CHANNEL_BOOST=2:3

# ---- Note -> LED mapping (uncalibrated prototype) ----
# linear: led = LED_OFFSET + (note - MIDI_BASE_NOTE), mirrored if LED_REVERSE=1; notes outside 0..119 are not lit.
MAPPING_MODE=linear
MIDI_BASE_NOTE=21
LED_OFFSET=0
LED_REVERSE=0
# table: explicit JSON { "midiNote": ledIndex }; setting NOTE_MAP_FILE alone selects table mode.
# generated: node tools/gen-note-map.js -> NOTE_MAP_FILE=config/note-map.json

# ---- Sustain pedal (CC64) ----
# keys: LED follows physical keys | sound: LED stays lit while the pedal sustains the note
SUSTAIN_MODE=keys

# ---- Step 3: MIDI ports (case-insensitive substrings of names shown by `npm run ports`) ----
# Leave empty until observed on the target machine; do not guess names.
KEYBOARD_IN_PORT=
SYNTHESIA_IN_PORT=
SYNTHESIA_OUT_PORT=
# 1: the app forwards keyboard messages to SYNTHESIA_OUT_PORT. Set 0 if routing is done with `aconnect`.
FORWARD_KEYBOARD=1
# 1: also play Synthesia's notes on the keyboard itself (its sound engine), sent to KEYBOARD_OUT_PORT.
# Default 0: Synthesia only drives the LEDs. KEYBOARD_OUT_PORT defaults to KEYBOARD_IN_PORT (same USB device, output side).
FORWARD_SYNTHESIA=0
KEYBOARD_OUT_PORT=
PORT_POLL_MS=2000
# >0: drop a Synthesia note identical to a keyboard note forwarded less than N ms earlier (only if Synthesia echoes input).
ECHO_GUARD_MS=0
# >0: clear Synthesia LEDs if no Synthesia message for N ms while notes are lit (0 = disabled).
SYNTH_STALE_MS=0

LOG_LEVEL=info

# ---- Pitch (hot-reloadable from the control UI) ----
# Synthesia must apply NO transpose / octave shift itself: everything is handled here and by the PSR.
# Sound output, Synthesia -> PSR (LEDs and Synthesia validation stay in the song's reference key).
AUDIO_TRANSPOSE_SEMITONES=0
AUDIO_OCTAVE_SHIFT=0
# Shift the PSR really applies on its MIDI OUT; compensated so Synthesia/LEDs see the physical key.
# Single global shift: Split/Dual with different octaves per part is not supported.
KEYBOARD_PHYSICAL_TRANSPOSE_SEMITONES=0
KEYBOARD_PHYSICAL_OCTAVE_SHIFT=0
